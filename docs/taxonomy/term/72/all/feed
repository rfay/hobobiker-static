        &lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/3002291231_Beautiful_Humahuaca_valley.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/3002291231_Beautiful_Humahuaca_valley.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
        &lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/3003109382_Randy_on_Jujuy_to_Salta_road.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/3003109382_Randy_on_Jujuy_to_Salta_road.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
        &lt;/div&gt;
