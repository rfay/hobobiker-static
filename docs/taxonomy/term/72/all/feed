&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/3002261027_Camping_at_the_chapel_Capilla_Vieja.jpg&quot;&gt;
