        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/3003327038_Randy_riding_the_Quebrada_de_Humahuaca_between_Purmamarca_and_Jujuy.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
        &lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/3003322606_the_route_from_Jujuy_to_Salta_Argentina.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/3003322606_the_route_from_Jujuy_to_Salta_Argentina.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
        &lt;/div&gt;
&lt;/div&gt;
&lt;/p&gt;
