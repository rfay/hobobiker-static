    <title>Lucho and the Casa de Ciclistas in Trujillo, Peru</title>
    <link>https://hobobiker-prep.ddev.site/lucho</link>
    <description>&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/2784759302_Lucho_with_his_son_Lance_In_training.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/2784759302_Lucho_with_his_son_Lance_In_training.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
