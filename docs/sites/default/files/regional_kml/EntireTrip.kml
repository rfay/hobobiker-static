				<heading>0.0001325713312857619</heading>
				<altitudeMode>relativeToGround</altitudeMode>
			</LookAt>
			<styleUrl>#msn_cycling_copy2</styleUrl>
			<Point>
				<coordinates>-108.9347667733505,27.01474769419627,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Entering Mexico!</name>
			<description>We entered Mexico on Nancy&apos;s birthday, February 9, 2007. No problems of any kind.</description>
			<LookAt>
				<longitude>-110.945913107484</longitude>
				<latitude>31.34488839558568</latitude>
				<altitude>0</altitude>
