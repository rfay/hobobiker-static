					<heading>2.073804698175827e-014</heading>
				</LookAt>
				<styleUrl>#msn_airports</styleUrl>
				<Point>
					<coordinates>-130.02804,55.9147,0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Ketchikan</name>
				<description>Ketchikan is a major center of Native American culture, with some pretty amazing Totems, and we enjoyed all that the and temperate rain forests that result from the 24x7 rain... Then we took the ferry to Prince Rupert, BC.</description>
