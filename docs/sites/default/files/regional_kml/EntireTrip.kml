		<Placemark>
			<name>Spanish School in Alamos</name>
			<description>We spent a week in Alamos studying Spanish. It&apos;s a pleasant town. Then we headed on a two-day adventure on dirt roads to El Fuerte.</description>
			<LookAt>
				<longitude>-108.9340111376595</longitude>
				<latitude>27.0151982115039</latitude>
				<altitude>0</altitude>
				<range>1001.541370075225</range>
