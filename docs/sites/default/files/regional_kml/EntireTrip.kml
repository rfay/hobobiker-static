		<Folder>
			<name>Copper Canyon</name>
			<open>1</open>
			<description>We took the famous tourist train &quot;El Chepe&quot; from El Fuerte up to Creel. Then we rode to Parral through wonderful mountains (lots of work).</description>
			<Style>
				<LineStyle>
					<color>ff000000</color>
					<width>3</width>
				</LineStyle>
				<PolyStyle>
					<fill>0</fill>
				</PolyStyle>
			</Style>
			<Placemark>
				<name>Batopilas</name>
				<description>Down in the very bottom of the canyon is Batopilas, which has been there longer than anything else (because of silver). We hitchhiked down this time - Randy rode it down in 2004.</description>
				<LookAt>
					<longitude>-107.7483314666236</longitude>
					<latitude>27.0279039588871</latitude>
					<altitude>0</altitude>
					<range>20170.67509928269</range>
					<tilt>0</tilt>
					<heading>-2.1980572418746e-006</heading>
					<altitudeMode>relativeToGround</altitudeMode>
				</LookAt>
				<styleUrl>#msn_ylw-pushpin0</styleUrl>
				<Point>
					<coordinates>-107.7469213139119,27.02465881349255,0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Creel, Chihuahua</name>
				<description>Creel is a big tourist town, but it&apos;s where you get ready for traveling in the Sierra Tarahumara.</description>
				<LookAt>
					<longitude>-107.6379124139019</longitude>
					<latitude>27.72899371272932</latitude>
					<altitude>0</altitude>
					<range>5133.919346732105</range>
					<tilt>1.478680992115589e-012</tilt>
					<heading>-0.03445367030208745</heading>
					<altitudeMode>relativeToGround</altitudeMode>
				</LookAt>
				<styleUrl>#msn_ylw-pushpin_copy2</styleUrl>
				<Point>
					<coordinates>-107.6362848472143,27.74383733575176,0</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>El Fuerto to Creel - El Chepe Train</name>
				<styleUrl>#sn_ylw-pushpin0</styleUrl>
				<LineString>
