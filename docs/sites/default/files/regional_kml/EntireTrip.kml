		<Folder>
			<name>Canada</name>
			<description>We started out June 9, 2006 from the northernmost place in Canada and rode south to Victoria, BC (on Vancouver Island), enjoying those wonderful Canadians and their country to the hilt.</description>
			<Placemark>
				<name>Inuvik - our starting place</name>
				<description>Inuvik is as far north as you can go on a road in Canada - it was our starting point, June 9, 2006.</description>
				<LookAt>
					<longitude>-133.7349299999999</longitude>
					<latitude>68.36105000000001</latitude>
					<altitude>0</altitude>
					<range>2737.816347292026</range>
					<tilt>1.47546107051003e-011</tilt>
					<heading>3.537292403537468e-014</heading>
