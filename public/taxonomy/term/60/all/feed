        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/2869624103_Nancy_on_Huancayo_to_Ayacucho_road_on_Rio_Mantaro.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
