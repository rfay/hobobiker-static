&lt;/div&gt;
&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/2822509082_Dancer_Inca_virgin_at_Huanuco_Pampa_celebration.jpg&quot;&gt;
