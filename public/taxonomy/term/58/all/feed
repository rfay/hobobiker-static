        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/2668290035_Coffee_drying_everywhere_on_the_road_from_Namballe_to_San_Ignacio.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/2668290035_Coffee_drying_everywhere_on_the_road_from_Namballe_to_San_Ignacio.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
        &lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickrfloat&quot;&gt;&lt;div class=&quot;flickr-img-wrapper&quot;&gt;
