		<Placemark>
			<name>Dawson City</name>
			<description>We spent 3 days enjoying the midnight sun in Dawson - it&apos;s an incredible historic city, the center of the Klondike Gold Rush.</description>
			<LookAt>
				<longitude>-139.4337527803667</longitude>
