        &lt;a rel=&quot;lightbox[group1][]&quot; href=&quot;/sites/default/files/3161020124_Randy_riding_the_rough_dirt_road_toward_Lago_Todos_Los_Santos_in_Chile.jpg&quot;&gt;
        &lt;div&gt;&lt;img src=&quot;https://hobobiker-prep.ddev.site/sites/default/files/imagecache/240x180/3161020124_Randy_riding_the_rough_dirt_road_toward_Lago_Todos_Los_Santos_in_Chile.jpg&quot; alt=&quot;&quot; title=&quot;&quot; rel=&quot;lightbox[group1][]&quot; /&gt;&lt;/div&gt;        &lt;/a&gt;
